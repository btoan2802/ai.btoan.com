-- Đang kết xuất đổ cấu trúc cơ sở dữ liệu cho btoan_ai
CREATE DATABASE IF NOT EXISTS `btoan_ai` /*!40100 DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci */;
USE `btoan_ai`;

-- Đang kết xuất đổ cấu trúc cho bảng btoan_ai.ai_training
CREATE TABLE IF NOT EXISTS `ai_training` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `question` text DEFAULT NULL,
  `ai_answer` text DEFAULT NULL,
  `correct_answer` text DEFAULT NULL,
  `user_id` int(11) DEFAULT NULL,
  `created_at` datetime DEFAULT current_timestamp(),
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=11 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Đang kết xuất đổ dữ liệu cho bảng btoan_ai.ai_training: ~0 rows (xấp xỉ)

-- Đang kết xuất đổ cấu trúc cho bảng btoan_ai.conversations
