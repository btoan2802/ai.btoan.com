<configuration>
  <system.webServer>

    <!-- cho phép đọc file -->
    <handlers>
      <clear />
      <add name="StaticFile" path="*" verb="*" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
    </handlers>

    <!-- cho anonymous -->
    <security>
      <authentication>
        <anonymousAuthentication enabled="true" />
      </authentication>
    </security>

  </system.webServer>
</configuration>